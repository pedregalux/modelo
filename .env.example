# ------------------------------------------------------------------
# KEYSTATIC — CMS
# ------------------------------------------------------------------

# El panel del CMS (http://localhost:4321/keystatic) funciona en modo
# local sin ninguna variable: edita los archivos de src/content/ directo.

# Para conectar el CMS con GitHub (los cambios se guardan como commits
# en tu repositorio y Cloudflare Pages redepliega automáticamente),
# define tu repositorio aquí y ejecuta `pnpm dev`:

PUBLIC_KEYSTATIC_GITHUB_REPO=tu-usuario/tu-repositorio

# Las siguientes variables las genera el propio asistente de Keystatic
# la primera vez que visitas /keystatic en desarrollo y pulsas
# "Login with GitHub". No las rellenes a mano (salvo que tengas una
# GitHub App propia):

# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ------------------------------------------------------------------
# CLOUDFLARE PAGES (solo CI, se configuran en GitHub > Settings > Secrets)
# ------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=