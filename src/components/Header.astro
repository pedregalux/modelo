---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="bg-white px-4 shadow-[0_2px_8px_rgba(15,18,25,0.05)]">
	<nav class="flex flex-wrap items-center justify-between gap-4">
		<h2 class="m-0 whitespace-nowrap text-2xl">
			<a href="/" class="no-underline">{SITE_TITLE}</a>
		</h2>
		<button
			class="nav-toggle group flex h-11 w-11 cursor-pointer flex-col justify-center gap-[5px] border-0 bg-transparent px-2.5 md:hidden"
			type="button"
			aria-expanded="false"
			aria-controls="internal-links"
			aria-label="Abrir menú"
		>
			<span class="block h-0.5 w-full bg-accent transition-all duration-200 group-[.active]:translate-y-[7px] group-[.active]:rotate-45"></span>
			<span class="block h-0.5 w-full bg-accent transition-all duration-200 group-[.active]:opacity-0"></span>
			<span class="block h-0.5 w-full bg-accent transition-all duration-200 group-[.active]:-translate-y-[7px] group-[.active]:-rotate-45"></span>
		</button>
		<div
			class="hidden w-full flex-col items-center pb-4 open:flex md:flex md:w-auto md:flex-row md:flex-wrap md:items-center md:gap-6 md:pb-0"
			id="internal-links"
		>
			<HeaderLink
				href="/"
				class="border-b-2 border-transparent px-2 py-[0.65em] text-accent md:border-b-4 md:py-4"
			>
				Inicio
			</HeaderLink>
			<HeaderLink
				href="/publications"
				class="border-b-2 border-transparent px-2 py-[0.65em] text-accent md:border-b-4 md:py-4"
			>
				Publicaciones
			</HeaderLink>
			<HeaderLink
				href="/projects"
				class="border-b-2 border-transparent px-2 py-[0.65em] text-accent md:border-b-4 md:py-4"
			>
				Proyectos
			</HeaderLink>
			<HeaderLink
				href="/research"
				class="border-b-2 border-transparent px-2 py-[0.65em] text-accent md:border-b-4 md:py-4"
			>
				Investigación
			</HeaderLink>
			<HeaderLink
				href="/videos"
				class="border-b-2 border-transparent px-2 py-[0.65em] text-accent md:border-b-4 md:py-4"
			>
				Videos
			</HeaderLink>
			<HeaderLink
				href="/blog"
				class="border-b-2 border-transparent px-2 py-[0.65em] text-accent md:border-b-4 md:py-4"
			>
				Blog
			</HeaderLink>
			<HeaderLink
				href="/about"
				class="border-b-2 border-transparent px-2 py-[0.65em] text-accent md:border-b-4 md:py-4"
			>
				Sobre mí
			</HeaderLink>
		</div>
	</nav>
</header>
<script>
	const toggle = document.querySelector('.nav-toggle');
	const links = document.getElementById('internal-links');
	if (toggle && links) {
		toggle.addEventListener('click', () => {
			const open = links.classList.toggle('open');
			toggle.classList.toggle('active', open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
		});
	}
</script>
