---
import { AUTHOR_EMAIL, AUTHOR_NAME, AUTHOR_URLS } from '../consts';

const today = new Date();
---

<footer class="bg-[linear-gradient(rgba(229,219,204,0.38),#f9f6ef)] px-4 pb-16 pt-8 text-center text-slate">
	<div class="flex flex-col items-center gap-2">
		<p class="m-0 font-bold text-night">{AUTHOR_NAME}</p>
		<p class="m-0">
			<a href={AUTHOR_URLS.email} class="no-underline text-accent hover:text-accent-dark">
				{AUTHOR_EMAIL}
			</a>
		</p>
		<div class="mt-2 flex flex-wrap justify-center gap-4">
			<a href={AUTHOR_URLS.orcid} target="_blank" class="no-underline text-accent hover:text-accent-dark text-[0.9em]">
				<span class="sr-only">Perfil ORCID</span>
				ORCID
			</a>
			<a href={AUTHOR_URLS.googlescholar} target="_blank" class="no-underline text-accent hover:text-accent-dark text-[0.9em]">
				<span class="sr-only">Google Scholar</span>
				Google Scholar
			</a>
			<a href={AUTHOR_URLS.github} target="_blank" class="no-underline text-accent hover:text-accent-dark text-[0.9em]">
				<span class="sr-only">GitHub</span>
				GitHub
			</a>
			<a href={AUTHOR_URLS.email} class="no-underline text-accent hover:text-accent-dark text-[0.9em]">
				<span class="sr-only">Correo</span>
				Correo
			</a>
		</div>
	</div>
	<p class="mt-6 text-[0.85em]">&copy; {today.getFullYear()} {AUTHOR_NAME}. Todos los derechos reservados.</p>
</footer>