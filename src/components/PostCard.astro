---
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>;

const { title, description, pubDate } = Astro.props.data;
---

<article class="border-b border-mist py-[1.25em]">
	<a class="group no-underline text-inherit" href={`/blog/${Astro.props.id}/`}>
		<h3 class="m-0 mb-[0.3em] text-[1.15em] text-accent group-hover:text-accent-dark">
			{title}
		</h3>
		<p class="m-0 mb-[0.4em] text-[0.9em] text-slate">
			<FormattedDate date={pubDate} />
		</p>
		<p class="m-0 text-[1em]">{description}</p>
	</a>
</article>