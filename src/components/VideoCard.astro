---
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'videos'>;

const { title, description, date, url, duration, tags } = Astro.props.data;
const youtubeId = url.match(/v=([^&]+)/)?.[1];
---

<article class="overflow-hidden rounded-xl border border-mist bg-white transition-shadow duration-200 hover:shadow-card">
	<a class="group no-underline text-inherit" href={url} target="_blank" rel="noopener">
		<div class="relative">
			{youtubeId ? (
				<img
					src={`https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`}
					alt=""
					loading="lazy"
					class="block h-[180px] w-full object-cover"
				/>
			) : (
				<div class="flex h-[180px] items-center justify-center bg-mist text-[2.5rem] text-slate">
					▶
				</div>
			)}
			{duration && (
				<span class="absolute bottom-2 right-2 rounded-md bg-black/75 px-2 py-[0.15em] text-[0.8em] text-white">
					{duration}
				</span>
			)}
		</div>
		<div class="p-4">
			<h3 class="m-0 mb-1 text-[1.05em] text-accent">{title}</h3>
			<p class="m-0 mb-2 text-[0.9em] text-slate">
				<FormattedDate date={date} />
			</p>
			<p class="m-0 mb-[0.8em] text-[0.95em]">{description}</p>
			<div class="flex flex-wrap gap-1">
				{tags.map((tag) => (
					<span class="rounded-full bg-mist px-2 py-[0.15em] text-[0.8em] text-night">{tag}</span>
				))}
			</div>
		</div>
	</a>
</article>