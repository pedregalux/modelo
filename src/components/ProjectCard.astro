---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'projects'>;

const { title, description, startDate, status, tags, heroImage, links } = Astro.props.data;
---

<article class="card">
	<a class="card-link" href={`/projects/${Astro.props.id}/`}>
		{heroImage && (
			<div class="thumb">
				<Image width={640} height={360} src={heroImage} alt="" />
			</div>
		)}
		<div class="body">
			<div class="meta">
				<span class="status status-{status}">{status}</span>
				<span class="date">Desde {startDate.getFullYear()}</span>
			</div>
			<h3 class="title">{title}</h3>
			<p class="description">{description}</p>
			<div class="tags">
				{tags.map((tag) => <span class="tag">{tag}</span>)}
			</div>
		</div>
	</a>
</article>
<style>
	.card {
		border-radius: 12px;
		border: 1px solid rgb(var(--gray-light));
		overflow: hidden;
		transition: box-shadow 0.2s ease;
		background: #fff;
	}
	.card:hover {
		box-shadow: var(--box-shadow);
	}
	.card-link {
		text-decoration: none;
		color: inherit;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 180px;
		object-fit: cover;
		border-radius: 0;
	}
	.body {
		padding: 1em;
	}
	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5em;
		margin-bottom: 0.5em;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.status {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.2em 0.6em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
	}
	.status-activo {
		background: rgba(34, 197, 94, 0.15);
		color: rgb(21, 128, 61);
	}
	.status-finalizado {
		background: rgba(59, 130, 246, 0.15);
		color: rgb(29, 78, 216);
	}
	.status-en-pausa {
		background: rgba(234, 179, 8, 0.15);
		color: rgb(133, 100, 4);
	}
	.title {
		margin: 0 0 0.4em 0;
		font-size: 1.2rem;
		color: var(--accent);
	}
	.description {
		margin: 0 0 0.8em 0;
		font-size: 0.95rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.tag {
		font-size: 0.8rem;
		padding: 0.15em 0.5em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
</style>