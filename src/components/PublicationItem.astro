---
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'publications'>;

const { title, authors, venue, type, date, doi, url, featured } = Astro.props.data;
const link = url || (doi ? `https://doi.org/${doi}` : undefined);
const year = date.getFullYear();
---

<li
	class:list={[
		'flex items-start justify-between gap-4 border-b border-mist py-[1.25em] max-[720px]:flex-col max-[720px]:gap-2',
		{ featured },
	]}
>
	<div>
		<h3
			class:list={[
				'm-0 mb-[0.3em] text-[1.1em] leading-[1.3]',
				featured && 'font-bold',
			]}
		>
			{link ? (
				<a href={link} target="_blank" rel="noopener" class="no-underline hover:underline">
					{title}
				</a>
			) : (
				title
			)}
		</h3>
		<p class="m-0 mb-1 text-[0.95em] text-slate">{authors}</p>
		<p class="m-0 text-[0.95em] italic">
			{venue}
			<span class="not-italic">({year})</span>
		</p>
	</div>
	<span class="shrink-0 rounded-full bg-mist px-[0.6em] py-1 text-[0.8em] uppercase tracking-[0.04em] text-night">
		{type}
	</span>
</li>