---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'research'>;

const { title, description, startDate, status, tags, heroImage } = Astro.props.data;

const statusClasses: Record<string, string> = {
	activo: 'bg-[rgba(34,197,94,0.15)] text-[rgb(21,128,61)]',
	finalizado: 'bg-[rgba(59,130,246,0.15)] text-[rgb(29,78,216)]',
	'en pausa': 'bg-[rgba(234,179,8,0.15)] text-[rgb(133,100,4)]',
};
---

<article class="overflow-hidden rounded-xl border border-mist bg-white transition-shadow duration-200 hover:shadow-card">
	<a class="group no-underline text-inherit" href={`/research/${Astro.props.id}/`}>
		{heroImage && (
			<div>
				<Image width={640} height={360} src={heroImage} alt="" class="block h-[180px] w-full object-cover" />
			</div>
		)}
		<div class="p-4">
			<div class="mb-2 flex items-center justify-between gap-2 text-[0.9em] text-slate">
				<span
					class:list={[
						'rounded-full px-[0.6em] py-[0.2em] text-[0.8em] uppercase tracking-[0.04em]',
						statusClasses[status],
					]}
				>
					{status}
				</span>
				<span>Desde {startDate.getFullYear()}</span>
			</div>
			<h3 class="m-0 mb-[0.4em] text-[1.15em] text-accent">{title}</h3>
			<p class="m-0 mb-[0.8em] text-[1em]">{description}</p>
			<div class="flex flex-wrap gap-1">
				{tags.map((tag) => (
					<span class="rounded-full bg-mist px-2 py-[0.15em] text-[0.8em] text-night">{tag}</span>
				))}
			</div>
		</div>
	</a>
</article>