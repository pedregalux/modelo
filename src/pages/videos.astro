---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION } from '../consts';

const videos = (await getCollection('videos')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={`Videos · ${AUTHOR_NAME}`} description={SITE_DESCRIPTION} mainClass="w-[960px]">
	<h1 class="mb-1 text-[3.052em] font-bold leading-[1.1] text-ink">Videos</h1>
	<p class="mb-8 text-slate">
		Conferencias, clases magistrales, tutoriales y entrevistas. Haz clic en cada tarjeta para ver el
		video en YouTube.
	</p>

	<div class="grid grid-cols-2 gap-6 max-[720px]:grid-cols-1">
		{videos.map((v) => <VideoCard {...v} />)}
	</div>
</BaseLayout>