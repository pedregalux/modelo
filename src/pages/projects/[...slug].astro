---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '../../consts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, description, startDate, endDate, status, tags, heroImage, links } = project.data;
const { Content } = await render(project);
const statusLabels: Record<string, string> = {
	activo: 'Activo',
	finalizado: 'Finalizado',
	'en pausa': 'En pausa',
};
---

<BaseLayout title={`${title} · ${AUTHOR_NAME}`} description={description}>
	<style slot="head">
		main {
			width: 720px;
		}
		.hero {
			margin-bottom: 1.5em;
		}
		.hero img {
			width: 100%;
			border-radius: 12px;
			box-shadow: var(--box-shadow);
		}
		.meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75em 1.5em;
			margin: 1em 0;
			font-size: 0.95rem;
			color: rgb(var(--gray));
		}
		.status {
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			padding: 0.2em 0.6em;
			border-radius: 999px;
			background: rgb(var(--gray-light));
		}
		.tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4em;
			margin: 1em 0;
		}
		.tag {
			font-size: 0.85rem;
			padding: 0.2em 0.6em;
			border-radius: 999px;
			background: rgb(var(--gray-light));
			color: rgb(var(--gray-dark));
		}
		.links {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75em;
			margin: 1.5em 0;
		}
		.links a {
			font-size: 0.9rem;
			padding: 0.45em 1em;
			border-radius: 999px;
			text-decoration: none;
			border: 1px solid rgb(var(--gray-light));
			color: var(--accent);
		}
		.links a:hover {
			border-color: var(--accent-dark);
			color: var(--accent-dark);
		}
	</style>

	<a href="/projects">← Todos los proyectos</a>

	<h1>{title}</h1>

	{heroImage && (
		<div class="hero">
			<Image width={1020} height={510} src={heroImage} alt="" />
		</div>
	)}

	<div class="meta">
		<span class="status">{statusLabels[status]}</span>
		<span>
			Desde {startDate.toLocaleDateString('es', { month: 'long', year: 'numeric' })}
			{endDate && ` — ${endDate.toLocaleDateString('es', { month: 'long', year: 'numeric' })}`}
		</span>
	</div>

	{links && (
		<div class="links">
			{links.site && (
				<a href={links.site} target="_blank" rel="noopener">Sitio del proyecto</a>
			)}
			{links.github && (
				<a href={links.github} target="_blank" rel="noopener">Código fuente</a>
			)}
			{links.paper && (
				<a href={links.paper} target="_blank" rel="noopener">Publicación</a>
			)}
		</div>
	)}

	<Content />

	<div class="tags">
		{tags.map((tag) => <span class="tag">{tag}</span>)}
	</div>
</BaseLayout>