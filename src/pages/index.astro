---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import VideoCard from '../components/VideoCard.astro';
import PostCard from '../components/PostCard.astro';
import {
	AUTHOR_AFFILIATION,
	AUTHOR_NAME,
	AUTHOR_ROLE,
	AUTHOR_SHORT_BIO,
	AUTHOR_URLS,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';

const publications = (await getCollection('publications')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featuredPublications = publications.filter((p) => p.data.featured).slice(0, 4);

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const featuredProjects = projects.filter((p) => p.data.featured).slice(0, 2);

const videos = (await getCollection('videos')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featuredVideos = videos.filter((v) => v.data.featured).slice(0, 2);

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = posts.slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="w-[960px]">
	<section class="mb-8 flex flex-col items-center text-center">
		<div>
			<h1 class="m-0 mb-[0.15em] text-[2.5rem]">{AUTHOR_NAME}</h1>
			<p class="m-0 mb-[0.2em] text-[1.1rem] font-bold text-accent">{AUTHOR_ROLE}</p>
			<p class="m-0 mb-3 text-slate">{AUTHOR_AFFILIATION}</p>
			<p class="mx-auto max-w-[60ch]">{AUTHOR_SHORT_BIO}</p>
			<div class="mt-4 flex flex-wrap justify-center gap-3">
				<a
					href={AUTHOR_URLS.orcid}
					target="_blank"
					rel="noopener"
					class="rounded-full border border-mist px-4 py-[0.45em] text-[0.9rem] no-underline text-accent hover:border-accent-dark hover:text-accent-dark"
				>
					ORCID
				</a>
				<a
					href={AUTHOR_URLS.googlescholar}
					target="_blank"
					rel="noopener"
					class="rounded-full border border-mist px-4 py-[0.45em] text-[0.9rem] no-underline text-accent hover:border-accent-dark hover:text-accent-dark"
				>
					Google Scholar
				</a>
				<a
					href={AUTHOR_URLS.email}
					class="rounded-full border border-mist px-4 py-[0.45em] text-[0.9rem] no-underline text-accent hover:border-accent-dark hover:text-accent-dark"
				>
					Contacto
				</a>
			</div>
		</div>
	</section>

	<section class="my-12">
		<div class="mb-5 flex items-baseline justify-between gap-4 border-b border-mist pb-2">
			<h2 class="m-0 text-[1.75rem]">Publicaciones destacadas</h2>
			<a href="/publications" class="text-[0.9rem] no-underline hover:underline">
				Ver todas →
			</a>
		</div>
		<ul class="m-0 list-none p-0">
			{featuredPublications.map((p) => <PublicationItem {...p} />)}
		</ul>
	</section>

	<section class="my-12">
		<div class="mb-5 flex items-baseline justify-between gap-4 border-b border-mist pb-2">
			<h2 class="m-0 text-[1.75rem]">Proyectos</h2>
			<a href="/projects" class="text-[0.9rem] no-underline hover:underline">
				Ver todos →
			</a>
		</div>
		<div class="grid grid-cols-2 gap-6 max-[720px]:grid-cols-1">
			{featuredProjects.map((p) => <ProjectCard {...p} />)}
		</div>
	</section>

	<section class="my-12">
		<div class="mb-5 flex items-baseline justify-between gap-4 border-b border-mist pb-2">
			<h2 class="m-0 text-[1.75rem]">Videos recientes</h2>
			<a href="/videos" class="text-[0.9rem] no-underline hover:underline">
				Ver todos →
			</a>
		</div>
		<div class="grid grid-cols-2 gap-6 max-[720px]:grid-cols-1">
			{featuredVideos.map((v) => <VideoCard {...v} />)}
		</div>
	</section>

	<section class="my-12">
		<div class="mb-5 flex items-baseline justify-between gap-4 border-b border-mist pb-2">
			<h2 class="m-0 text-[1.75rem]">Del blog</h2>
			<a href="/blog" class="text-[0.9rem] no-underline hover:underline">
				Ver todas las entradas →
			</a>
		</div>
		{recentPosts.map((post) => <PostCard {...post} />)}
	</section>
</BaseLayout>