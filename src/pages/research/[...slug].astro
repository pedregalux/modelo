---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '../../consts';

export async function getStaticPaths() {
	const research = await getCollection('research');
	return research.map((item) => ({
		params: { slug: item.id },
		props: item,
	}));
}
type Props = CollectionEntry<'research'>;

const item = Astro.props;
const { title, description, startDate, endDate, status, tags, heroImage, links } = item.data;
const { Content } = await render(item);
const statusLabels: Record<string, string> = {
	activo: 'Activo',
	finalizado: 'Finalizado',
	'en pausa': 'En pausa',
};
---

<BaseLayout title={`${title} · ${AUTHOR_NAME}`} description={description}>
	<a href="/research" class="text-accent hover:text-accent-dark">← Toda la investigación</a>

	<h1 class="mb-2 text-[3.052em] font-bold leading-[1.1] text-ink">{title}</h1>

	{heroImage && (
		<div class="mb-6">
			<Image width={1020} height={510} src={heroImage} alt="" class="w-full rounded-xl shadow-card" />
		</div>
	)}

	<div class="my-4 flex flex-wrap gap-x-6 gap-y-3 text-[0.95em] text-slate">
		<span class="rounded-full bg-mist px-[0.6em] py-[0.2em] text-[0.8em] uppercase tracking-[0.04em]">
			{statusLabels[status]}
		</span>
		<span>
			Desde {startDate.toLocaleDateString('es', { month: 'long', year: 'numeric' })}
			{endDate && ` — ${endDate.toLocaleDateString('es', { month: 'long', year: 'numeric' })}`}
		</span>
	</div>

	{links && (
		<div class="my-6 flex flex-wrap gap-3">
			{links.site && (
				<a
					href={links.site}
					target="_blank"
					rel="noopener"
					class="rounded-full border border-mist px-4 py-[0.45em] text-[0.9em] no-underline text-accent hover:border-accent-dark hover:text-accent-dark"
				>
					Sitio del proyecto
				</a>
			)}
			{links.github && (
				<a
					href={links.github}
					target="_blank"
					rel="noopener"
					class="rounded-full border border-mist px-4 py-[0.45em] text-[0.9em] no-underline text-accent hover:border-accent-dark hover:text-accent-dark"
				>
					Código fuente
				</a>
			)}
			{links.paper && (
				<a
					href={links.paper}
					target="_blank"
					rel="noopener"
					class="rounded-full border border-mist px-4 py-[0.45em] text-[0.9em] no-underline text-accent hover:border-accent-dark hover:text-accent-dark"
				>
					Publicación
				</a>
			)}
		</div>
	)}

	<div class="prose">
		<Content />
	</div>

	<div class="my-4 flex flex-wrap gap-1">
		{tags.map((tag) => (
			<span class="rounded-full bg-mist px-[0.6em] py-[0.2em] text-[0.85em] text-night">{tag}</span>
		))}
	</div>
</BaseLayout>